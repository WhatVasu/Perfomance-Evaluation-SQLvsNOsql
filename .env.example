# Application Configuration
APP_NAME="Mongo vs Postgres E-Commerce Benchmark"
DEBUG=false
SECRET_KEY="super-secret-benchmark-key-change-in-production-12345678"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Backend Switch: "postgres" or "mongo"
DB_BACKEND="postgres"

# PostgreSQL Settings
POSTGRES_USER="benchmark"
POSTGRES_PASSWORD="benchmark_secret"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="ecommerce_benchmark"
POSTGRES_POOL_SIZE=50
POSTGRES_MAX_OVERFLOW=0

# MongoDB Settings
MONGO_USER="benchmark"
MONGO_PASSWORD="benchmark_secret"
MONGO_HOST="localhost"
MONGO_PORT=27017
MONGO_DB="ecommerce_benchmark"
MONGO_REPLICA_SET="rs0"
MONGO_POOL_SIZE=50

# Fairness Parameters
MONGO_WRITE_CONCERN="majority"
MONGO_JOURNAL=true
POSTGRES_SYNCHRONOUS_COMMIT="on"
